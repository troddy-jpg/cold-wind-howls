pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
function _init()
	col1,col2=1,0
	rain = {}
	for i=1,50 do 
		rain[i]={
			x = rnd(132), y = rnd(132)
		}
	end
end
function _update()
	for i=1,#rain do
		local s = rain[i]
		s.x += sin(time() * 0.25 + i * 0.1)
		s.y += (i * 0.4)
		if s.y > 128 then s.y = 4 end
	end
end
function _draw()
	cls(col2)
	-- draw rain
    for i=1,#rain do
        local s = rain[i]
        rectfill(s.x , s.y , s.x + 2, s.y + 2, col1)
    end
end
