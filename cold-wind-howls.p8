-- should start sitting at bottom and need to lift up and pick knife up from top
-- to start the game

-- feedback that the knife is charging
	-- blink when charged
-- apples that are tossed up and if hit break into pieces and splatter, healing?

#include main.lua
#include states.lua


function _init() 
	cartdata("cold-wind-howls")
	init_menu() -- set act_update and act_draw to menustate
end

-- pico8 update / draw SET TO WHATEVER FUNCTION LIVES AT REGISTER act_update / act_draw
function _update() 
	act_update() 
	t = ( t + 1 ) % 1000 -- wrap every 1k
end
function _draw() cls() act_draw() end

   
